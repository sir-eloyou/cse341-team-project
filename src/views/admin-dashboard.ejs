<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
    <title><%= title %></title>
</head>
<body>

    <header class="bg-white shadow-sm py-3 mb-4">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">

            <h4 class="fw-bold mb-0">
                <%= title %>
            </h4>

            <a href="/" class="btn btn-outline-primary">
                <i class="bi bi-house-door me-2"></i>
                Back to Main Page
            </a>


        </div>
    </div>
    </header>


    
    <div class="container py-4">

        <h4 class="mb-3 mt-4">Quick Links</h4>

        <div class="row g-3">

            <!-- Booking Admin -->
            <div class="col-md-6">
                <a href="/bookings-admin"
                class="card text-decoration-none shadow-sm border-0 h-100">
                    <div class="card-body d-flex align-items-center gap-3">

                        <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3">
                            <i class="bi bi-ticket-perforated fs-2"></i>
                        </div>

                        <div>
                            <h5 class="card-title text-dark mb-1">
                                Booking Admin
                            </h5>
                            <p class="text-muted mb-0">
                                Manage bookings
                            </p>
                        </div>

                        <i class="bi bi-arrow-right ms-auto text-secondary"></i>

                    </div>
                </a>
            </div>

            <!-- User Admin -->
            <div class="col-md-6">
                <a href="/user-admin"
                class="card text-decoration-none shadow-sm border-0 h-100">
                    <div class="card-body d-flex align-items-center gap-3">

                        <div class="bg-success bg-opacity-10 text-success rounded-3 p-3">
                            <i class="bi bi-people fs-2"></i>
                        </div>

                        <div>
                            <h5 class="card-title text-dark mb-1">
                                User Admin
                            </h5>
                            <p class="text-muted mb-0">
                                Manage users
                            </p>
                        </div>

                        <i class="bi bi-arrow-right ms-auto text-secondary"></i>

                    </div>
                </a>
            </div>
        </div>
    </div>


    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>







