<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
    <title><%= title %></title>
</head>
<body>

    <header class="bg-white shadow-sm py-3 mb-4">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">

            <h4 class="fw-bold mb-0">
                Welcome, <%= user.name %>!
            </h4>

            <a href="/" class="btn btn-outline-primary">
                <i class="bi bi-house-door me-2"></i>
                Back to Main Page
            </a>


        </div>
    </div>
    </header>


    
    <div class="container py-4">
        <div class="row g-3" id="booking-container">
            <p id="booking-message"></p>
        </div>

        <h4 class="mb-3 mt-4">Quick Links</h4>

        <div class="row g-3">

            <!-- Booking Admin -->
            <div class="col-md-6">
                <a href="/bookings-admin"
                class="card text-decoration-none shadow-sm border-0 h-100">
                    <div class="card-body d-flex align-items-center gap-3">

                        <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3">
                            <i class="bi bi-ticket-perforated fs-2"></i>
                        </div>

                        <div>
                            <h5 class="card-title text-dark mb-1">
                                Booking Admin
                            </h5>
                            <p class="text-muted mb-0">
                                Manage bookings
                            </p>
                        </div>

                        <i class="bi bi-arrow-right ms-auto text-secondary"></i>

                    </div>
                </a>
            </div>

            <!-- User Admin -->
            <div class="col-md-6">
                <a href="/admin-dashboard"
                class="card text-decoration-none shadow-sm border-0 h-100">
                    <div class="card-body d-flex align-items-center gap-3">

                        <div class="bg-success bg-opacity-10 text-success rounded-3 p-3">
                            <i class="bi bi-people fs-2"></i>
                        </div>

                        <div>
                            <h5 class="card-title text-dark mb-1">
                                User Admin
                            </h5>
                            <p class="text-muted mb-0">
                                Manage users
                            </p>
                        </div>

                        <i class="bi bi-arrow-right ms-auto text-secondary"></i>

                    </div>
                </a>
            </div>
        </div>
    </div>

    
    <template id="booking-template">
        <div class="card shadow-sm">
                <div class="card-body">

                    <div class="d-flex justify-content-between mb-3">
                        <span class="badge bg-success">Confirmed</span>
                        <small class="text-muted" id="ticket-number"></small>
                    </div>

                    <h5 class="fw-bold" id="trip-name"></h5>

                    <!-- Schedule Time -->
                    <div class="row align-items-center my-4">

                        <div class="col-5">
                            <h4 class="mb-0" id="departure-hour"></h4>
                            <small class="text-muted">Departure</small>
                        </div>

                        <div class="col-2 text-center">
                            <i class="bi bi-arrow-right"></i>
                        </div>

                        <div class="col-5">
                            <h4 class="mb-0" id="arrival-hour"></h4>
                            <small class="text-muted">Arrival</small>
                        </div>

                    </div>

                    <hr>

                    <div class="row g-3">

                        <div class="col-6">
                            <small class="text-muted">Travel Day</small>
                            <p class="fw-semibold mb-0" id="travel-day">Tuesday</p>
                        </div>

                        <div class="col-6">
                            <small class="text-muted">Passengers</small>
                            <p class="fw-semibold mb-0" id="passengers-count"></p>
                        </div>

                        <div class="col-6">
                            <small class="text-muted">Ticket Class</small>
                            <p class="fw-semibold mb-0" id="ticket-class"></p>
                        </div>

                        <div class="col-6">
                            <small class="text-muted">Booking Date</small>
                            <p class="fw-semibold mb-0" id="booking-date"></p>
                        </div>

                    </div>

                </div>
            </div>
    </template>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        
        const hookBookingCatalog = async () => {
    const listEl = document.querySelector('#booking-container');
    const templateEl = document.getElementById('booking-template');
    const messageEl = document.getElementById('booking-message');

    if (!listEl || !templateEl) {
        return;
    }

    try {
        const response = await fetch('/api/user-bookings');

        if (!response.ok) {
            throw new Error(`Failed to load bookings (${response.status})`);
        }

        const payload = await response.json();
        const bookings = payload.data || [];

        // Clear previous booking cards
        listEl.querySelectorAll('.booking-column').forEach(el => el.remove());

        // Check if there are no bookings
        if (bookings.length === 0) {
            messageEl.textContent = "You have no bookings yet.";
            messageEl.hidden = false;
            messageEl.className = "text-center text-muted py-5 fs-5";
            return;
        }

        // Hide empty booking message
        messageEl.hidden = true;

        const fragment = document.createDocumentFragment();

        bookings.forEach((booking) => {
            const card = templateEl.content.cloneNode(true);
            const column = document.createElement('div');

            column.className = 'col-12 col-sm-6 col-lg-4 booking-column';

            card.querySelector("#ticket-number").textContent = booking.id;
            card.querySelector("#trip-name").textContent = booking.trip.name;

            card.querySelector("#departure-hour").textContent =
                booking.schedule.departureTime;

            card.querySelector("#arrival-hour").textContent =
                booking.schedule.arrivalTime;

            card.querySelector("#travel-day").textContent =
                booking.selectedDay.charAt(0).toUpperCase() +
                booking.selectedDay.slice(1);

            card.querySelector("#passengers-count").textContent =
                booking.passengers.length;

            card.querySelector("#ticket-class").textContent =
                booking.ticketClass.charAt(0).toUpperCase() +
                booking.ticketClass.slice(1);

            card.querySelector("#booking-date").textContent =
                new Date(booking.createdAt).toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "numeric"
                });

            column.appendChild(card);
            fragment.appendChild(column);
        });

        listEl.appendChild(fragment);

    } catch (error) {
        console.error("Error loading bookings:", error);

        messageEl.textContent = "Unable to load your bookings. Please try again later.";
        messageEl.hidden = false;
        messageEl.className = "text-center text-danger py-5 fs-5";
    }
};


        document.addEventListener('DOMContentLoaded', () => {
            hookBookingCatalog();
        });
    </script>
</body>
</html>







