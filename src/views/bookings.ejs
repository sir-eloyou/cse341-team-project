<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
    <title><%= title %></title>
</head>
<body>

    <header class="bg-white shadow-sm py-3 mb-4">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">

            <h4 class="fw-bold mb-0">
                Bookings Admin
            </h4>

            <a href="/" class="btn btn-outline-primary">
                <i class="bi bi-house-door me-2"></i>
                Back to Main Page
            </a>

        </div>
    </div>
    </header>


    
    <div class="container py-4">
        <div class="row g-3" id="booking-container">
        </div>
    </div>

    <template id="booking-template">
        <div class="card shadow-sm">
                <div class="card-body">

                    <div class="d-flex justify-content-between mb-3">
                        <span class="badge bg-success">Confirmed</span>
                        <small class="text-muted" id="ticket-number"></small>
                    </div>

                    <h5 class="fw-bold" id="trip-name"></h5>

                    <!-- Schedule Time -->
                    <div class="row align-items-center my-4">

                        <div class="col-5">
                            <h4 class="mb-0" id="departure-hour"></h4>
                            <small class="text-muted">Departure</small>
                        </div>

                        <div class="col-2 text-center">
                            <i class="bi bi-arrow-right"></i>
                        </div>

                        <div class="col-5">
                            <h4 class="mb-0" id="arrival-hour"></h4>
                            <small class="text-muted">Arrival</small>
                        </div>

                    </div>

                    <hr>

                    <div class="row g-3">

                        <div class="col-6">
                            <small class="text-muted">Travel Day</small>
                            <p class="fw-semibold mb-0" id="travel-day">Tuesday</p>
                        </div>

                        <div class="col-6">
                            <small class="text-muted">Passengers</small>
                            <p class="fw-semibold mb-0" id="passengers-count"></p>
                        </div>

                        <div class="col-6">
                            <small class="text-muted">Ticket Class</small>
                            <p class="fw-semibold mb-0" id="ticket-class"></p>
                        </div>

                        <div class="col-6">
                            <small class="text-muted">Booking Date</small>
                            <p class="fw-semibold mb-0" id="booking-date"></p>
                        </div>

                    </div>

                </div>
            </div>
    </template>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const hookBookingCatalog = async () => {
            const listEl = document.querySelector('#booking-container');
            const templateEl = document.getElementById('booking-template');

            if (!listEl || !templateEl) {
                return;
            }

            try {
                const response = await fetch('/api/bookings');
                if (!response.ok) {
                    throw new Error(`Failed to load trains (${response.status})`);
                }

                const payload = await response.json();
                let bookings = payload.data || [];
                const fragment = document.createDocumentFragment();


                bookings.forEach((booking) => {
                    const card = templateEl.content.cloneNode(true);
                    const column = document.createElement('div');
                    column.className = 'col-12 col-sm-6 col-lg-4';
                    card.querySelector("#ticket-number").textContent = booking.id;
                    card.querySelector("#trip-name").textContent = booking.trip.name;
                    card.querySelector("#departure-hour").textContent = booking.schedule.departureTime;
                    card.querySelector("#arrival-hour").textContent = booking.schedule.arrivalTime;
                    card.querySelector("#travel-day").textContent = booking.selectedDay.charAt(0).toUpperCase() + booking.selectedDay.slice(1);
                    card.querySelector("#passengers-count").textContent = booking.passengers.length
                    card.querySelector("#ticket-class").textContent = booking.ticketClass.charAt(0).toUpperCase() + booking.ticketClass.slice(1);
                    card.querySelector("#booking-date").textContent = new Date(booking.createdAt).toLocaleDateString("en-US", {
                        year: "numeric",
                        month: "short",
                        day: "numeric"
                    });;
                    



                

                
                    column.appendChild(card);
                    fragment.appendChild(column);
                });

                listEl.replaceChildren(fragment);
            
            } catch (error) {
                console.log(error)
            }
        };



        document.addEventListener('DOMContentLoaded', () => {
            hookBookingCatalog();
        });
    </script>
</body>
</html>







